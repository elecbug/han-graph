# Match the owner of var/ (id -u / id -g on Linux).
HAN_GRAPH_UID=1000
HAN_GRAPH_GID=1000

HAN_GRAPH_HOST=0.0.0.0
HAN_GRAPH_PORT=18080

# Private accounts, sessions, wordbooks, notes and dictionary. Choose file or firestore.
HAN_GRAPH_DB_BACKEND=file
# Firestore uses Application Default Credentials. This path is inside the container.
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/app/var/google-credentials.json
# FIRESTORE_EMULATOR_HOST=emulator:8080

# Google Sign-In web client ID. Leave blank for username/password-only signup.
# HAN_GRAPH_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
