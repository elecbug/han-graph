# Cloud Run uses this file list too (see .gcloudignore).
**
!/Dockerfile
!/LICENSE
!/src/LICENSE
!/src/go.mod
!/src/go.sum
!/src/cmd/*.go
!/src/internal/account/*.go
!/src/internal/graph/*.go
!/src/internal/webapp/*.go
!/src/internal/webapp/privacy.json
**/*_test.go
!/src/internal/webapp/static/index.html
!/src/internal/webapp/static/app.js
!/src/internal/webapp/static/*.mjs
!/src/internal/webapp/static/*.css
!/src/internal/webapp/static/favicon.svg
!/src/internal/webapp/static/robots.txt
!/src/internal/webapp/static/fonts/*.woff2
!/src/internal/webapp/static/fonts/*.ttf
!/src/internal/webapp/static/fonts/LICENSE
!/dataset/character.jsonl
!/dataset/example.jsonl
!/dataset/meta.jsonl
!/dataset/word.jsonl
!/dataset/practice.json
!/dataset/audio/ko/*.zip
!/dataset/audio/README.md
!/dataset/LICENSE
!/dataset/TARGETS.md
!/dataset/sources/README.md
!/dataset/sources/nikl_2003_beginner.tsv
!/dataset/sources/nikl_2003_beginner_coverage.jsonl
!/dataset/sources/vocabulary_expansion.tsv
**/.*
!/.dockerignore
